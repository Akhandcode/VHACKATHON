# OpenAI API Key & Model Configuration
OPENAI_API_KEY="sk-proj-your-openai-api-key"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_LLM_MODEL="gpt-4o"

# Supabase Persistence & pgvector Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_ANON_KEY="your-anon-key"

# Upstash QStash Worker Queue Secrets
QSTASH_URL="https://qstash.upstash.io/v2/publish/"
QSTASH_TOKEN="your-qstash-token"
QSTASH_CURRENT_SIGNING_KEY="sig_your_current_key"
QSTASH_NEXT_SIGNING_KEY="sig_your_next_key"

# Threshold Settings
SIMILARITY_THRESHOLD=0.82
EDITORIAL_MIN_SCORE=0.70
